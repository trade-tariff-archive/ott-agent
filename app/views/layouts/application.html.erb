<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csp_meta_tag %>
    <title>OTT Agent</title>
    <link rel="stylesheet" href="https://unpkg.com/govuk-frontend@5.4.1/dist/govuk/govuk-frontend.min.css"
          integrity="sha384-0y0LE7iGeEdQGJwmgYDDO6a50GyjWIodWtQ238oVf/OiaPw/6xoyuF4yd9fBs7rA"
          crossorigin="anonymous">
    <%= csrf_meta_tags %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="govuk-template__body">
    <a href="#main-content" class="govuk-skip-link">Skip to main content</a>

    <header class="govuk-header" role="banner">
      <div class="govuk-header__container govuk-width-container">
        <div class="govuk-header__content">
          <a href="/" class="govuk-header__link govuk-header__service-name">OTT Agent</a>
          <nav aria-label="Menu" class="govuk-header__nav">
            <ul class="govuk-header__navigation-list">
              <li class="govuk-header__navigation-item">
                <%= link_to "Conversations", conversations_path, class: "govuk-header__link" %>
              </li>
              <li class="govuk-header__navigation-item">
                <%= link_to "Watchlist", standing_intents_path, class: "govuk-header__link" %>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content">
        <% if flash[:alert] %>
          <div class="govuk-error-summary">
            <p class="govuk-body"><%= flash[:alert] %></p>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
