<%= turbo_stream_from @conversation %>

<h1 class="govuk-heading-l"><%= @conversation.title %></h1>

<div id="agent-status" class="govuk-body-s govuk-hint govuk-!-margin-bottom-2"></div>

<div class="govuk-!-margin-bottom-6">
  <% @messages.each do |message| %>
    <div class="govuk-inset-text govuk-!-margin-bottom-3">
      <p class="govuk-caption-m govuk-!-margin-bottom-1">
        <%= message.role == 'user' ? 'You' : 'Assistant' %>
        <% if message.role == 'assistant' && message.input_tokens > 0 %>
          · <%= number_with_delimiter(message.input_tokens + message.output_tokens) %> tokens
          · <%= message.latency_seconds.round(1) %>s
        <% end %>
      </p>
      <div class="app-message-content"><%= render_markdown(message.content) %></div>
    </div>
  <% end %>

  <% if @messages.last&.role == "user" %>
    <div id="assistant-response-pending" class="govuk-inset-text govuk-!-margin-bottom-3">
      <p class="govuk-caption-m govuk-!-margin-bottom-1">Assistant</p>
      <div id="streaming-message-content" class="app-message-content">
        <p class="govuk-body govuk-hint app-thinking">Thinking<span class="app-thinking__dots"><span>.</span><span>.</span><span>.</span></span></p>
      </div>
    </div>
  <% end %>

  <div id="messages-bottom"></div>
</div>

<%= form_with url: conversation_messages_path(@conversation), method: :post do |f| %>
  <%= f.govuk_text_area :content, label: { text: "Ask a question" }, rows: 3 %>
  <%= f.govuk_submit "Send", data: { turbo_submits_with: "Sending…" } %>
<% end %>

<p class="govuk-body-s govuk-!-margin-top-4">
  <%= link_to "← All conversations", conversations_path, class: "govuk-link" %>
</p>
